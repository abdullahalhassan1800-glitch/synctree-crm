# Server
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/synctree_crm?retryWrites=true&w=majority
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=https://synctree-crm.vercel.app

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=CRM System

# Uploads
UPLOAD_DIR=uploads
